clear_console()

string input = prompt("Would you like to go on an adventure?\n(Enter \"y\" for yes or \"n\" for no)")

while input != "y" and input != "n":
	input = prompt("Sorry. I don't understand. Please enter \"y\" for yes or \"n\" for no")

if input == "y":
	input = prompt("We shall go on a grand adventure. Press \"x\" to cancel")
	if input != "x":
		print("You aren't good at instructions. You failed")
	else:
		input = prompt("Good job. Now for real, would you like to continue?")
		
		while input != "y" and input != "n":
			input = prompt("Sorry. I don't understand. Please enter \"y\" for yes or \"n\" for no")
		
		if input == "y":
			print("More coming soon")
		else:
			print("Oh well")
else:
	print("Goodbye")
